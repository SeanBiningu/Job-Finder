# Workly environment configuration
#
# Client-side values: React only exposes variables starting with REACT_APP_.
# The Supabase anon key is designed for browser use when Row Level Security is enabled.
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side only: do NOT prefix this with REACT_APP_.
# Keep this key in your hosting provider's environment variables in production.
THEIRSTACK_API_KEY=your_theirstack_api_key
